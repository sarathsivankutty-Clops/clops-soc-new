# Configurable Host Ports & Browser Origin Variables for docker-compose.yml
# Copy or merge these into .env (no secrets here).
# Changing PUBLIC_HOST, PUBLIC_SCHEME or PUBLIC_PORT_SUFFIX requires rebuilding
# `web`, because NEXT_PUBLIC_* is inlined at image build time:
#   docker compose build web

# Public hostname / IP used by browsers and CORS origins
PUBLIC_HOST=localhost
# Browser URL: scheme and an optional port suffix. Empty suffix means the
# scheme's default port (nginx listens on 80/443).
PUBLIC_SCHEME=http
PUBLIC_PORT_SUFFIX=
PUBLIC_WS_SCHEME=ws

# The TLS edge. These are the only ports the stack publishes; everything else
# binds 127.0.0.1. See docs/DEPLOY-HTTPS.md.
HTTP_PORT=80
HTTPS_PORT=443

# Public-facing services, reachable only through nginx since the TLS edge
# landed — kept here because resolve_port_conflicts.py and the old runbooks
# still name them, not because anything binds them.
WEB_PORT=13000
REALTIME_PORT=18086

# Optional explicit browser build-arg / CORS / URL overrides
# NEXT_PUBLIC_WS_URL=ws://localhost
# NEXT_PUBLIC_REALTIME_URL=http://localhost
# AISOC_CORS_ORIGINS=http://localhost
# AISOC_CONSOLE_URL=http://localhost
# AISOC_WEB_BASE_URL=http://localhost
# ALERTMANAGER_EXTERNAL_URL=http://localhost:19094

# CORE services (bound to 127.0.0.1 by default)
API_PORT=18000
AGENTS_PORT=18001
ACTIONS_PORT=18002
FUSION_PORT=18003
THREATINTEL_PORT=18005
INGEST_HTTP_PORT=18081
INGEST_METRICS_PORT=19090
CONNECTORS_PORT=18088
QDRANT_PORT=16333
LITELLM_PORT=14000
OLLAMA_PORT=21434

# Full-profile services (bound to 127.0.0.1 by default)
ENRICHMENT_PORT=18080
UEBA_PORT=18007
KAFKA_UI_PORT=18090
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
OPENSEARCH_PORT=19200
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687

# Optional profile services (bound to 127.0.0.1 by default)
PURPLE_TEAM_PORT=18006
HONEYTOKENS_PORT=18008
SLACK_BOT_PORT=18009
TEAMS_BOT_PORT=18010
OSQUERY_TLS_PORT=18091
MCP_PORT=18096
PROMETHEUS_PORT=19091
ALERTMANAGER_PORT=19094
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318
TEMPO_PORT=13200
GRAFANA_PORT=13001
