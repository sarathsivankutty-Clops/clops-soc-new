# AiSOC Environment Configuration Example for EC2 Deployment (100.25.223.93)
# ==============================================================================
# Usage on EC2:
#   1. Merge or copy to .env:  cp .env.ec2.example .env (and retain your secrets)
#   2. Ensure secret keys (SECRET_KEY, AISOC_CREDENTIAL_KEY, etc.) match your existing instance secrets.
#   3. Rebuild the web container so NEXT_PUBLIC_* variables are inlined:
#        docker compose build web
#   4. Restart the web and fusion services:
#        docker compose up -d web fusion
# ==============================================================================

# --- Public Host & Network Bindings -------------------------------------------
# Public IP / DNS of the EC2 instance accessible by end-user browsers
PUBLIC_HOST=100.25.223.93

# Port assignments for public-facing services
WEB_PORT=13000
REALTIME_PORT=18086

# Bind to 0.0.0.0 so external browsers can reach the console and realtime WS gateway
AISOC_CONSOLE_BIND_ADDR=0.0.0.0
AISOC_REALTIME_BIND_ADDR=0.0.0.0
AISOC_BIND_ADDR=127.0.0.1

# Browser and Console Origin URLs
AISOC_CONSOLE_URL=http://100.25.223.93:13000
AISOC_WEB_BASE_URL=http://100.25.223.93:13000
ALERTMANAGER_EXTERNAL_URL=http://100.25.223.93:19094

# Allowed CORS origins for API and Realtime WebSocket/SSE services
AISOC_CORS_ORIGINS=http://100.25.223.93:13000,http://localhost:13000,http://localhost:3000,http://localhost:3001

# WebSocket and Realtime endpoints inlined into web bundle at build time
NEXT_PUBLIC_WS_URL=ws://100.25.223.93:18086
NEXT_PUBLIC_REALTIME_URL=http://100.25.223.93:18086

# --- Internal Service Upstreams (Container-to-Container) ---------------------
API_URL=http://api:8000
AGENTS_URL=http://agents:8084
REALTIME_URL=http://realtime:4000
FUSION_URL=http://fusion:8003
OSQUERY_TLS_URL=http://osquery-tls:9001
HONEYTOKENS_URL=http://honeytokens:8005
PURPLE_TEAM_URL=http://purple-team:8006
CONNECTORS_SERVICE_URL=http://connectors:8003
LLM_GATEWAY_URL=http://litellm:4000/v1

# Core application host ports (mapped on loopback 127.0.0.1)
API_PORT=18000
AGENTS_PORT=18001
ACTIONS_PORT=18002
FUSION_PORT=18003
THREATINTEL_PORT=18005
INGEST_HTTP_PORT=18081
INGEST_METRICS_PORT=19090
CONNECTORS_PORT=18088
QDRANT_PORT=16333
LITELLM_PORT=14000
OLLAMA_PORT=21434

# General platform settings
ENVIRONMENT=production
LOG_LEVEL=info
AISOC_DEMO_MODE=false
AISOC_VERSION=latest

# LLM & Investigation budgets
AISOC_INVESTIGATOR_MAX_COMPLETION_TOKENS=1000
AISOC_INVESTIGATOR_LLM_TIMEOUT_SECONDS=120
AISOC_INVESTIGATION_MAX_SECONDS=600
AISOC_DEEP_INVESTIGATION_BUDGET_SECONDS=600
