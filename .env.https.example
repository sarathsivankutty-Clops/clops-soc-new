# HTTPS deployment template — soc.cloudifyops.com behind nginx + Let's Encrypt.
# No secrets in this file. Merge it into the server's `.env`, which stays
# untracked:
#
#   cat .env.https.example >> .env
#
# Everything here is read at container start except the NEXT_PUBLIC_* pair,
# which Next inlines at image build time — so changing them means
# `docker compose build web`, not a restart. Full runbook: docs/DEPLOY-HTTPS.md.

# --- Public identity ---------------------------------------------------------
PUBLIC_HOST=soc.cloudifyops.com
PUBLIC_SCHEME=https
# Empty because nginx serves 443. The suffix is `${PUBLIC_PORT_SUFFIX-}`, so
# an explicitly empty value is kept rather than replaced by a default.
PUBLIC_PORT_SUFFIX=
# The browser opens wss://, not ws://, on the TLS listener.
PUBLIC_WS_SCHEME=wss

# --- The edge ----------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# Let's Encrypt expiry notices go here. CHANGE THIS before the first issue.
ACME_EMAIL=ops@cloudifyops.com

# `bootstrap` is the default and the correct value until a certificate exists.
# Uncomment after `docker compose run --rm certbot` has produced the lineage:
# NGINX_CONF_DIR=tls

# --- URLs the browser and the backend agree on -------------------------------
AISOC_CONSOLE_URL=https://soc.cloudifyops.com
AISOC_WEB_BASE_URL=https://soc.cloudifyops.com
AISOC_CORS_ORIGINS=https://soc.cloudifyops.com
NEXT_PUBLIC_WS_URL=wss://soc.cloudifyops.com
NEXT_PUBLIC_REALTIME_URL=https://soc.cloudifyops.com

# Alertmanager is not proxied by nginx yet, so it keeps its loopback port and
# is not reachable from the internet. Leave it as is until a location exists.
ALERTMANAGER_EXTERNAL_URL=https://soc.cloudifyops.com:19094

# --- Client-IP attribution behind the proxy ----------------------------------
# The API ignores X-Forwarded-For unless the direct peer is listed here
# (services/api/app/core/trusted_proxy.py), so without it audit rows record
# the nginx container's address instead of the client's. Set it to the compose
# network's subnet — print it with:
#   docker network inspect clopsoc_clops-soc --format '{{(index .IPAM.Config 0).Subnet}}'
# then uncomment and paste. Do not use a wider range than that subnet.
# AISOC_TRUSTED_PROXIES=
