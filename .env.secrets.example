# Secret credentials for Keycloak and OIDC — NO defaults in docker-compose.yml.
# Copy to `.env.secrets` (gitignored, chmod 600) and generate real values with
# `openssl rand -hex 32` before starting the stack:
#
#   docker compose --env-file .env --env-file .env.secrets up -d
#
# Do NOT store real values in `.env` or in `infra/keycloak/realm-clopssoc.json`.

# Dedicated Keycloak Postgres database password (keycloak-db service)
KEYCLOAK_DB_PASSWORD=<generate-with-openssl-rand-hex-32>

# Keycloak initial bootstrap admin credentials (rotate via SSH tunnel on first login)
KEYCLOAK_ADMIN_USER=kc-bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=<generate-with-openssl-rand-hex-32>

# OIDC client secret for `clopssoc-console` (set in Keycloak client -> Credentials,
# and read by the API container as OIDC_CLIENT_SECRET)
OIDC_CLIENT_SECRET=<paste-client-secret-from-keycloak>
