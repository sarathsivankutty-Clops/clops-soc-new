# Reference only — this file is NOT loaded. nginx's conf.d include is
# `*.conf`, and this one is `.example` so a half-configured identity provider
# cannot break the console.
#
# When Keycloak is added at auth.cloudifyops.com:
#   1. copy this file to `30-auth.conf`;
#   2. issue its certificate
#      (`docker compose run --rm -e CERTBOT_ARGS="certonly --webroot -w /var/www/certbot -d auth.cloudifyops.com --email <you> --agree-tos --no-eff-email --non-interactive --staging" certbot`);
#   3. copy the `ssl_*`, OCSP and `resolver` lines from 20-soc.conf;
#   4. `docker compose exec nginx nginx -t && docker compose exec nginx nginx -s reload`.
#
# Nothing in 20-soc.conf changes. That is the point of the server-name
# snippets: each block names its own host and they share `default_server`,
# so adding a host never means editing the one already serving traffic.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    include /etc/nginx/snippets/server-name-auth.conf;
    include /etc/nginx/snippets/security-headers.conf;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/auth.cloudifyops.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.cloudifyops.com/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/auth.cloudifyops.com/chain.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=300s ipv6=off;

    client_max_body_size 8m;

    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 120s;
        proxy_pass http://keycloak:8080;
    }
}
